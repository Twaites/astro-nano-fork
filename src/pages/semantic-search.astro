---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import SemanticSearchComponent from "@components/SemanticSearch";
import { SEMANTIC_SEARCH } from "@consts";
---

<PageLayout title={SEMANTIC_SEARCH.TITLE} description={SEMANTIC_SEARCH.DESCRIPTION}>
  <Container>
    <div class="space-y-8">
      <div class="animate font-semibold text-black dark:text-white text-xl">
        Semantic Search
      </div>
      <div class="animate">
        <SemanticSearchComponent client:only="solid-js" />
      </div>
    </div>
  </Container>
</PageLayout>
