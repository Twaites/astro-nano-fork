---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import SmartSearchComponent from "@components/SmartSearch";
import { SMART_SEARCH } from "@consts";
---

<PageLayout title={SMART_SEARCH.TITLE} description={SMART_SEARCH.DESCRIPTION}>
  <Container>
    <div class="space-y-8">
      <div class="animate font-semibold text-black dark:text-white text-xl">
        Smart Search
      </div>
      <div class="animate">
        <SmartSearchComponent client:only="solid-js" />
      </div>
    </div>
  </Container>
</PageLayout>
