{
  "name": "astro-nano",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "dev:network": "astro dev --host",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "preview:network": "astro preview --host",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "index:changed": "node scripts/index-changed.mjs",
    "index:rebuild": "node scripts/reindex-all.mjs",
    "prod-build": "astro check && astro build && npm run index:changed"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.5",
    "@astrojs/mdx": "^4.3.9",
    "@astrojs/netlify": "^6.6.0",
    "@astrojs/rss": "^4.0.13",
    "@astrojs/sitemap": "^3.6.0",
    "@astrojs/solid-js": "^5.1.2",
    "@astrojs/tailwind": "^6.0.2",
    "@fontsource/inter": "^5.0.17",
    "@fontsource/lora": "^5.0.16",
    "@tailwindcss/typography": "^0.5.10",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "@upstash/search": "^0.1.6",
    "astro": "^5.15.3",
    "clsx": "^2.1.0",
    "dompurify": "^3.1.6",
    "eslint": "^8.57.0",
    "eslint-plugin-astro": "^0.32.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "fuse.js": "^7.0.0",
    "remark": "^15.0.1",
    "sharp": "^0.33.3",
    "solid-js": "^1.8.18",
    "strip-markdown": "^6.0.0",
    "tailwind-merge": "^2.2.2",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.2"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5"
  }
}
